PORT=5000
FRONTEND_URL=http://localhost:3001

# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/auth/spotify/callback
SPOTIFY_STATE_SECRET=

# Firebase Admin uses Application Default Credentials.
# For local development, point this to a private key outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=
